# Auto detect text files and perform LF normalization
* text=auto

# Keep line endings consistent per script/build file type
Makefile text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.exe binary
*.dll binary
